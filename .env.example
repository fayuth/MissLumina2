# Copia este archivo a .env y ajusta los valores reales.
#   cp .env.example .env
#   nano .env
# El archivo .env esta ignorado por Git (no se sube al repositorio).

# --- Base de datos PostgreSQL ---
DB_URL=jdbc:postgresql://127.0.0.1:5432/miss_lumina_db
DB_USERNAME=postgres
DB_PASSWORD=cambia_esta_clave

# --- Usuario administrador que se crea al arrancar (opcional) ---
APP_ADMIN_NOMBRE=Administrador
APP_ADMIN_CORREO=admin@misslumina.com
APP_ADMIN_CLAVE=TuClaveAdmin123
APP_ADMIN_TELEFONO=3001234567
